# Database - for Docker Compose
POSTGRES_USER=j2tracker
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=j2_tracker

# Database - for local development (combines the above)
DATABASE_URL=postgresql://j2tracker:j2tracker@localhost:5432/j2_tracker

# Microsoft Graph API (configure in Phase 1c)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_USER_EMAIL=
GRAPH_TARGET_FOLDER=Supplier Orders

# App Security
SECRET_KEY=change-this-to-a-random-secret-key

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Server
API_HOST=localhost
API_PORT=8000
STREAMLIT_PORT=8501
